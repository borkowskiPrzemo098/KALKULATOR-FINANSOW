generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Użytkownik loguje się samą nazwą użytkownika + hasłem — bez e-maila,
// bez numeru telefonu. Zapomniane hasło resetuje wyłącznie administrator
// (isAdmin = true) — patrz /admin/users w aplikacji.
model User {
  id           String                @id @default(cuid())
  username     String                @unique
  passwordHash String
  displayName  String
  isAdmin      Boolean               @default(false)
  createdAt    DateTime              @default(now())
  transactions Transaction[]
  categories   Category[]
  recurring    RecurringTransaction[]
}

// icon: klucz z zestawu autorskich ikon SVG (src/components/icons.tsx,
// CATEGORY_ICONS) — świadomie nie emoji. color: hex, używany na wykresie
// kołowym i jako akcent w liście. monthlyLimit: opcjonalny budżet
// miesięczny (tylko dla kategorii wydatków) — pasek postępu na dashboardzie.
model Category {
  id           String                @id @default(cuid())
  userId       String
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  type         String // "income" | "expense"
  icon         String                @default("other")
  color        String                @default("#c9a45c")
  monthlyLimit Decimal?              @db.Decimal(12, 2)
  createdAt    DateTime              @default(now())
  transactions Transaction[]
  recurring    RecurringTransaction[]

  @@index([userId])
}

model Transaction {
  id          String               @id @default(cuid())
  userId      String
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recurringId String?
  recurring   RecurringTransaction? @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  type        String // "income" | "expense"
  amount      Decimal              @db.Decimal(12, 2)
  description String?
  occurredOn  DateTime             @db.Date
  createdAt   DateTime             @default(now())

  @@index([userId])
  @@index([occurredOn])
  @@index([recurringId])
}

// Reguła cykliczna: co miesiąc, dnia `dayOfMonth`, materializuje się jako
// zwykła Transaction (patrz src/lib/recurring.ts) — żeby lista transakcji
// i wykresy nie musiały nic wiedzieć o "cykliczności", tylko widzą gotowe
// wpisy powiązane przez recurringId.
model RecurringTransaction {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  type        String // "income" | "expense"
  amount      Decimal       @db.Decimal(12, 2)
  description String?
  dayOfMonth  Int // 1-28, żeby działało w każdym miesiącu
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  transactions Transaction[]

  @@index([userId])
}
